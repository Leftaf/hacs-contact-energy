#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

# Use the mounted Home Assistant config volume in the devcontainer, or the
# repository config directory when running outside it.
CONFIG_DIR="${HA_CONFIG_DIR:-${PWD}/config}"
mkdir -p "${CONFIG_DIR}"

if [[ ! -f "${CONFIG_DIR}/configuration.yaml" ]]; then
    cp "${PWD}/config/configuration.yaml" "${CONFIG_DIR}/configuration.yaml"
fi

# Keep the integration source in the repository while Home Assistant uses its
# selected configuration directory.
export PYTHONPATH="${PYTHONPATH}:${PWD}/custom_components"

# Start Home Assistant
hass --config "${CONFIG_DIR}" --debug
